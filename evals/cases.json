{
  "about": "Eval cases for the spec writer (v1.1, frozen before the grounding tables existed). Each sentence goes through the same LLM + validation loop as prompt.py; the checks run on the final spec. Checks are ranges, not exact values, except where the sentence gives an exact hex. Colour checks use HSV hue (degrees) and saturation (0-1) and CIE L* lightness (0-100); named_colour checks use evals/colour_definitions.json. model_unsupported_mentions only looks at the model's own unsupported list, never at items the code added. style_shift compares a case's colour with an earlier case's (mean over its runs). A run also fails if no valid spec came back within 2 attempts. None of these sentences may be used to tune the prompt or the tables.",
  "cases": [
    {
      "id": "red_lipstick",
      "covers": "named colour, realistic lipstick size",
      "sentence": "a red lipstick box",
      "checks": [
        {"type": "hue", "min": 345, "max": 15},
        {"type": "saturation", "min": 0.5},
        {"type": "dimension", "field": "height_cm", "min": 6, "max": 10},
        {"type": "dimension", "field": "width_cm", "min": 1.5, "max": 4},
        {"type": "dimension", "field": "depth_cm", "min": 1.5, "max": 4}
      ]
    },
    {
      "id": "navy_serum",
      "covers": "named colour: navy",
      "sentence": "a navy blue serum box",
      "checks": [
        {"type": "named_colour", "name": "navy"}
      ]
    },
    {
      "id": "hex_exact",
      "covers": "exact hex",
      "sentence": "a perfume box in #1B4D3E",
      "checks": [
        {"type": "hex", "equals": "#1B4D3E"}
      ]
    },
    {
      "id": "hex_glossy",
      "covers": "exact hex, glossy",
      "sentence": "a glossy box in #F4B6C2",
      "checks": [
        {"type": "hex", "equals": "#F4B6C2"},
        {"type": "roughness", "max": 0.2}
      ]
    },
    {
      "id": "glossy_black",
      "covers": "glossy, named colour",
      "sentence": "a glossy black perfume box",
      "checks": [
        {"type": "roughness", "max": 0.2},
        {"type": "lightness", "max": 20}
      ]
    },
    {
      "id": "shiny_gold",
      "covers": "shiny (= glossy), named colour: gold",
      "sentence": "a shiny gold candle box",
      "checks": [
        {"type": "roughness", "max": 0.2},
        {"type": "named_colour", "name": "gold"}
      ]
    },
    {
      "id": "matte_white",
      "covers": "matte, named colour",
      "sentence": "a matte white face cream carton",
      "checks": [
        {"type": "roughness", "min": 0.6},
        {"type": "lightness", "min": 85}
      ]
    },
    {
      "id": "camera_front",
      "covers": "camera: front, named colour",
      "sentence": "front view of a yellow soap box",
      "checks": [
        {"type": "camera", "equals": "front"},
        {"type": "hue", "min": 40, "max": 65}
      ]
    },
    {
      "id": "camera_top_down",
      "covers": "camera: top_down, flat proportions",
      "sentence": "overhead shot of a flat blue jewellery box",
      "checks": [
        {"type": "camera", "equals": "top_down"},
        {"type": "ratio", "num": "height_cm", "den": "width_cm", "max": 0.5},
        {"type": "ratio", "num": "height_cm", "den": "depth_cm", "max": 0.5}
      ]
    },
    {
      "id": "camera_three_quarter",
      "covers": "camera: three_quarter, named colour",
      "sentence": "a purple tea box, three-quarter view",
      "checks": [
        {"type": "camera", "equals": "three_quarter"},
        {"type": "hue", "min": 255, "max": 315}
      ]
    },
    {
      "id": "tall",
      "covers": "tall proportions, named colour",
      "sentence": "a tall, slim grey box",
      "checks": [
        {"type": "ratio", "num": "height_cm", "den": "width_cm", "gt": 1.5},
        {"type": "saturation", "max": 0.2}
      ]
    },
    {
      "id": "flat",
      "covers": "flat proportions",
      "sentence": "a flat square box for a silk scarf",
      "checks": [
        {"type": "ratio", "num": "height_cm", "den": "width_cm", "max": 0.5},
        {"type": "ratio", "num": "height_cm", "den": "depth_cm", "max": 0.5},
        {"type": "ratio", "num": "width_cm", "den": "depth_cm", "min": 0.9, "max": 1.1}
      ]
    },
    {
      "id": "vague",
      "covers": "vague prompt",
      "sentence": "a nice box",
      "checks": [
        {"type": "is_box", "equals": true},
        {"type": "unsupported_empty"},
        {"type": "size", "side": "longest", "min": 5, "max": 60}
      ]
    },
    {
      "id": "not_a_box",
      "covers": "non-box; material the renderer can't do",
      "sentence": "a glass perfume bottle",
      "checks": [
        {"type": "is_box", "equals": false},
        {"type": "shape_contains", "any": ["bottle"]},
        {"type": "model_unsupported_mentions", "any": ["glass", "transparen"]}
      ]
    },
    {
      "id": "logo",
      "covers": "logo request",
      "sentence": "a white matte box with a gold logo on the front",
      "checks": [
        {"type": "model_unsupported_mentions", "any": ["logo"]},
        {"type": "is_box", "equals": true},
        {"type": "lightness", "min": 85},
        {"type": "roughness", "min": 0.6}
      ]
    },
    {
      "id": "bottle_logo",
      "covers": "non-box plus a logo",
      "sentence": "a pink perfume bottle with gold logo",
      "checks": [
        {"type": "is_box", "equals": false},
        {"type": "shape_contains", "any": ["bottle"]},
        {"type": "model_unsupported_mentions", "any": ["logo"]}
      ]
    },
    {
      "id": "doc_lipstick",
      "covers": "docs render 1: luxury vs plain, matte, lipstick size",
      "sentence": "luxury matte red lipstick box, three-quarter view",
      "checks": [
        {"type": "hue", "min": 345, "max": 15},
        {"type": "style_shift", "than": "red_lipstick", "direction": "darker_or_less_saturated", "min_lightness": 5, "min_saturation": 0.1},
        {"type": "roughness", "min": 0.6},
        {"type": "camera", "equals": "three_quarter"},
        {"type": "dimension", "field": "height_cm", "min": 6, "max": 10},
        {"type": "dimension", "field": "width_cm", "min": 1.5, "max": 4},
        {"type": "dimension", "field": "depth_cm", "min": 1.5, "max": 4}
      ]
    },
    {
      "id": "doc_emerald",
      "covers": "docs render 2: emerald, high-gloss, blush backdrop",
      "sentence": "a high-gloss emerald green perfume box on a pale blush backdrop",
      "checks": [
        {"type": "named_colour", "name": "emerald"},
        {"type": "roughness", "max": 0.1},
        {"type": "named_colour", "name": "blush", "target": "background"},
        {"type": "camera", "equals": "three_quarter"}
      ]
    },
    {
      "id": "doc_sage",
      "covers": "docs render 3: sage, matte, top-down, gift box shape",
      "sentence": "flat lay of a matte sage green skincare gift box, seen from above",
      "checks": [
        {"type": "named_colour", "name": "sage"},
        {"type": "roughness", "min": 0.6},
        {"type": "camera", "equals": "top_down"},
        {"type": "top_aspect", "max": 1.6}
      ]
    },
    {
      "id": "emerald_serum",
      "covers": "named colour: emerald",
      "sentence": "an emerald green serum box",
      "checks": [
        {"type": "named_colour", "name": "emerald"}
      ]
    },
    {
      "id": "sage_tea",
      "covers": "named colour: sage",
      "sentence": "a sage green tea box",
      "checks": [
        {"type": "named_colour", "name": "sage"}
      ]
    },
    {
      "id": "crimson",
      "covers": "named colour: crimson",
      "sentence": "a crimson perfume box",
      "checks": [
        {"type": "named_colour", "name": "crimson"}
      ]
    },
    {
      "id": "wine_gift",
      "covers": "named colour: wine, gift box shape",
      "sentence": "a wine coloured gift box",
      "checks": [
        {"type": "named_colour", "name": "wine"},
        {"type": "top_aspect", "max": 1.6}
      ]
    },
    {
      "id": "blush",
      "covers": "named colour: blush",
      "sentence": "a blush pink candle box",
      "checks": [
        {"type": "named_colour", "name": "blush"}
      ]
    },
    {
      "id": "champagne",
      "covers": "named colour: champagne",
      "sentence": "a champagne coloured jewellery box",
      "checks": [
        {"type": "named_colour", "name": "champagne"}
      ]
    },
    {
      "id": "high_gloss_white",
      "covers": "high-gloss",
      "sentence": "a high-gloss white cosmetics box",
      "checks": [
        {"type": "roughness", "max": 0.1},
        {"type": "lightness", "min": 85}
      ]
    },
    {
      "id": "plain_red",
      "covers": "style pair, reference",
      "sentence": "a red box",
      "checks": [
        {"type": "hue", "min": 345, "max": 15},
        {"type": "saturation", "min": 0.5}
      ]
    },
    {
      "id": "luxury_red",
      "covers": "style pair: luxury = darker or less saturated",
      "sentence": "a luxury red box",
      "checks": [
        {"type": "hue", "min": 345, "max": 15},
        {"type": "style_shift", "than": "plain_red", "direction": "darker_or_less_saturated", "min_lightness": 5, "min_saturation": 0.1}
      ]
    },
    {
      "id": "plain_blue",
      "covers": "style pair, reference",
      "sentence": "a blue box",
      "checks": [
        {"type": "hue", "min": 190, "max": 250}
      ]
    },
    {
      "id": "playful_blue",
      "covers": "style pair: playful = lighter or more saturated",
      "sentence": "a playful blue box",
      "checks": [
        {"type": "hue", "min": 190, "max": 250},
        {"type": "style_shift", "than": "plain_blue", "direction": "lighter_or_more_saturated", "min_lightness": 5, "min_saturation": 0.1}
      ]
    }
  ]
}
